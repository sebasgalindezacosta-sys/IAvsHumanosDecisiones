# --- Base de datos ---------------------------------------------------------
# En Vercel NO tienes que escribir esto: al conectar la base Neon desde
# Storage, Vercel crea DATABASE_URL solo. Aquí es solo para correrlo en tu PC.
#   Opción A (recomendada): copia la DATABASE_URL de Vercel → Storage → tu base → .env.local
#   Opción B: un Postgres local, p. ej. postgres://postgres:postgres@localhost:5432/decisiones
DATABASE_URL=

# --- Panel de investigadoras (/admin) --------------------------------------
# Contraseña larga para descargar los CSV. Ponla también en Vercel →
# Settings → Environment Variables. No la compartas ni la subas a GitHub.
ADMIN_TOKEN=
